@model ik.Models.Izin
@{
    ViewData["Title"] = "İzni Düzenle";
}

<div class="row">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <form asp-action="Edit" method="post">

                    @* ═══ GİZLİ ALANLAR ═══
                       Formda görünmeyen ama sunucuya taşınması gereken veriler. *@

                    @* Hangi kaydı güncelliyoruz? WHERE için şart. *@
                    <input type="hidden" asp-for="IzinId" />

                    @* Kayıt tarihi değişmemeli *@
                    <input type="hidden" asp-for="CreatedDate" />

                    @* Aktiflik durumu korunmalı *@
                    <input type="hidden" asp-for="IsActive" />

                    @* Durum (Beklemede/Onaylandı/Reddedildi) bu formdan değişmiyor,
                       onaylama/reddetme ayrı action'lardan yapılıyor *@
                    <input type="hidden" asp-for="Durum" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="PersonelId" class="form-label"></label>
                            @* Controller'da PersonelListesiniHazirla(izin.PersonelId)
                               çağrıldığı için mevcut personel seçili gelir *@
                            <select asp-for="PersonelId" asp-items="ViewBag.Personeller"
                                    class="form-select">
                                <option value="">-- Personel seçin --</option>
                            </select>
                            <span asp-validation-for="PersonelId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="IzinTipi" class="form-label"></label>
                            <select asp-for="IzinTipi" class="form-select">
                                <option value="Yillik">Yillik</option>
                                <option value="Mazeret">Mazeret</option>
                            </select>
                            <span asp-validation-for="IzinTipi" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="BaslangicTarihi" class="form-label"></label>
                            <input asp-for="BaslangicTarihi" type="date" class="form-control" />
                            <span asp-validation-for="BaslangicTarihi" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="BitisTarihi" class="form-label"></label>
                            <input asp-for="BitisTarihi" type="date" class="form-control" />
                            <span asp-validation-for="BitisTarihi" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12 mb-3">
                            <label asp-for="Aciklama" class="form-label"></label>
                            <textarea asp-for="Aciklama" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Aciklama" class="text-danger small"></span>
                        </div>
                    </div>

                    @* Kayıt geçmişi — bilgi amaçlı, düzenlenemez *@
                    <div class="text-muted small mb-3">
                        <i class="bi bi-clock-history"></i>
                        Oluşturuldu: @Model.CreatedDate.ToString("dd.MM.yyyy HH:mm")

                        @if (Model.UpdatedDate.HasValue)
                        {
                            <span> &nbsp;|&nbsp; Güncellendi: @Model.UpdatedDate.Value.ToString("dd.MM.yyyy HH:mm")</span>
                        }
                    </div>

                    <hr />

                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-check-lg"></i> Değişiklikleri kaydet
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Vazgeç</a>

                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}