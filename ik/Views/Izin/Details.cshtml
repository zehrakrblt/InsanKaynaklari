@model ik.Models.Izin
@{
    ViewData["Title"] = "İzin Detayı";
}

<div class="row">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">

            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <span class="fw-semibold">İzin Detayı</span>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-arrow-left"></i> Listeye dön
                </a>
            </div>

            <div class="card-body">
                <h6 class="text-muted mb-3">Kişisel Bilgiler</h6>

                <dl class="row mb-0">
                    <dt class="col-sm-4">Ad Soyad</dt>
                    <dd class="col-sm-8 fw-semibold">@Model.PersonelAdi</dd>

                    <dt class="col-sm-4">Departman</dt>
                    <dd class="col-sm-8">
                        <span class="badge bg-secondary">@Model.DepartmanAd</span>
                    </dd>

                    <dt class="col-sm-4">İzin Tipi</dt>
                    <dd class="col-sm-8">@Model.IzinTipi</dd>

                    <dt class="col-sm-4">Tarih Aralığı</dt>
                    <dd class="col-sm-8">
                        @Model.BaslangicTarihi.ToString("dd.MM.yyyy") -
                        @Model.BitisTarihi.ToString("dd.MM.yyyy")
                    </dd>

                    <dt class="col-sm-4">Gün Sayısı</dt>
                    <dd class="col-sm-8">@Model.GunSayisi</dd>

                    <dt class="col-sm-4">Durum</dt>
                    <dd class="col-sm-8">
                        @{
                            string rozetSinifi = Model.Durum switch
                            {
                                "Onaylandı" => "bg-success",
                                "Reddedildi" => "bg-danger",
                                _ => "bg-secondary"
                            };
                        }
                        <span class="badge @rozetSinifi">@Model.Durum</span>
                    </dd>

                    @if (!string.IsNullOrWhiteSpace(Model.Aciklama))
                    {
                        <dt class="col-sm-4">Açıklama</dt>
                        <dd class="col-sm-8">@Model.Aciklama</dd>
                    }
                </dl>
            </div>

            <div class="card-footer bg-white">
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-arrow-left"></i> Listeye dön
                </a>
            </div>

        </div>
    </div>
</div>