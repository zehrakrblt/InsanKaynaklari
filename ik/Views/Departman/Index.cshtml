@model List<ik.Models.Departman>
@{
    ViewData["Title"] = "Departmanlar";
}

@if (TempData["Basarili"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle"></i> @TempData["Basarili"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Uyari"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show">
        <i class="bi bi-exclamation-triangle"></i> @TempData["Uyari"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <span class="fw-semibold">Departmanlar (@Model.Count)</span>
        <a asp-action="Create" class="btn btn-success btn-sm">
            <i class="bi bi-plus-lg"></i> Yeni Departman
        </a>
    </div>

    <div class="card-body p-0">
        @if (Model.Count == 0)
        {
            <div class="text-center text-muted py-5">
                <i class="bi bi-tags fs-1 d-block mb-2"></i>
                <p class="mb-3">Henüz Departman yok.</p>
                <a asp-action="Create" class="btn btn-sm btn-success">İlk Departmanı ekle</a>
            </div>
        }
        else
        {
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Departman</th>
                        <th>Açıklama</th>
                        <th class="text-center">Personel Sayısı</th>
                        
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model)
                    {
                        <tr>
                            
                                @* Renk alanı doğrudan Bootstrap sınıf adı olarak kullanılıyor *@
                            
                            <td class="small text-muted">
                                @* ⭐ NULL kontrolü — açıklama boş olabilir *@
                                @if (string.IsNullOrWhiteSpace(d.Aciklama))
                                {
                                    <span class="fst-italic">—</span>
                                }
                                else
                                {
                                    @d.Aciklama
                                }
                            </td>

                            <td class="text-center">
                                <span class="badge bg-light text-dark">@d.PersonelSayisi</span>
                            </td>

                            <td class="text-end">

                                <a asp-action="Details" asp-route-id="@d.DepartmanId"
                                   class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-info-circle"></i>
                                    </a>

                                <a asp-action="Edit" asp-route-id="@d.DepartmanId"
                                   class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@d.DepartmanId"
                                   class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>