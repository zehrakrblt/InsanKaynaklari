@model ik.Models.Departman
@{
    ViewData["Title"] = "Yeni Departman";
}

<div class="row">
    <div class="col-md-7">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <form asp-action="Create" method="post">

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="mb-3">
                        <label asp-for="DepartmanAd" class="form-label"></label>
                        <input asp-for="DepartmanAd" class="form-control" autofocus />
                        <span asp-validation-for="DepartmanAd" class="text-danger small"></span>
                    </div>

                   
                       

                    <div class="mb-3">
                        <label asp-for="Aciklama" class="form-label"></label>
                        <textarea asp-for="Aciklama" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Aciklama" class="text-danger small"></span>
                        @* ⭐ Zorunlu olmadığını kullanıcıya SÖYLE *@
                        <div class="form-text">İsteğe bağlı.</div>
                    </div>

                    <hr />
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-check-lg"></i> Departmanı kaydet
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Vazgeç</a>

                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}